# tape-archiver data worker — REFERENCE unit for ubuntu-storage-host-01.
#
# Executable documentation of the runtime requirements in SPEC §4.1. The host's
# copy is managed out-of-band (see README.md). systemd is the sole supervisor:
# `docker run` in the foreground with --rm.
#
# Before enabling: install /etc/tape-archiver/data-worker.env, pin
# TAPE_ARCHIVER_IMAGE, and set REQUIRED_DEVICES to this host's real tape nodes
# (`lsscsi -g`; sg numbers follow discovery order).

[Unit]
Description=tape-archiver data worker (reference unit for ubuntu-storage-host-01)
Documentation=https://github.com/solidDoWant/tape-archiver/blob/master/docs/data-worker-image.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# A persistently broken host lands in `failed` instead of restarting forever.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple

# Content-anchored tag; --pull=never means it must already be loaded.
Environment=TAPE_ARCHIVER_IMAGE=ghcr.io/soliddowant/tape-archiver/data-worker:REPLACE_WITH_PINNED_TAG
# The real library's nodes. A missing one fails the start, naming it.
Environment="REQUIRED_DEVICES=/dev/nst0 /dev/nst1 /dev/sch0 /dev/sg0 /dev/sg1 /dev/sg2 /dev/zfs /dev/fuse"

EnvironmentFile=/etc/tape-archiver/data-worker.env

RuntimeDirectory=tape-archiver-data-worker
ExecStartPre=/bin/sh -c 'F=""; for d in $REQUIRED_DEVICES; do \
      [ -e "$d" ] || { echo "required device $d is missing" >&2; exit 1; }; \
      F="$F --device $d"; \
    done; \
    echo "DEVICE_FLAGS=$F" > /run/tape-archiver-data-worker/devices.env'
EnvironmentFile=-/run/tape-archiver-data-worker/devices.env

# Optional dry-run support (docs/tapectl.md): the mhvtl virtual library, passed
# through only when all of it is present — a one-drive virtual library cannot
# rehearse a two-copy run. Nodes are resolved from the stable /dev/mhvtl/* udev
# symlinks and mapped at both their kernel path and the stable path. The mirror
# also needs /etc/mhvtl, the media home (MHVTL_HOME_PATH in mhvtl.conf, mounted
# at the same path), and --ipc=host to reach the daemons' message queue.
#
# After restarting mhvtl, check `systemctl status vtltape@11 vtltape@12` and
# `lsscsi -g`: vtltape@.service uses KillMode=none, so an old daemon can survive
# a stop and make its replacement exit.
ExecStartPre=/bin/sh -c 'F=""; N="changer drive0 drive1 sg-changer sg-drive0 sg-drive1"; P=0; \
    for n in $N; do [ -e "/dev/mhvtl/$n" ] && P=$((P+1)); done; \
    if [ "$P" = 6 ]; then \
      for n in $N; do R=$(readlink -f "/dev/mhvtl/$n"); F="$F --device $R --device $R:/dev/mhvtl/$n"; done; \
      F="$F --ipc=host --mount type=bind,source=/etc/mhvtl,target=/etc/mhvtl"; \
      H=$(. /etc/mhvtl/mhvtl.conf >/dev/null 2>&1; echo "$MHVTL_HOME_PATH"); \
      [ -d "$H" ] && F="$F --mount type=bind,source=$H,target=$H"; \
    elif [ "$P" != 0 ]; then \
      echo "mhvtl is only partly present ($P of 6 /dev/mhvtl nodes); dry runs are disabled" >&2; \
    fi; \
    echo "MHVTL_DEVICE_FLAGS=$F" > /run/tape-archiver-data-worker/mhvtl.env'
EnvironmentFile=-/run/tape-archiver-data-worker/mhvtl.env

# Snapshot automounts under .zfs/snapshot only reach the container if the host
# mount is shared; without this they are silently invisible.
ExecStartPre=/bin/mount --make-rshared /mnt/bulk-pool-01
ExecStartPre=-/usr/bin/docker rm -f tape-archiver-data-worker

# SYS_ADMIN: LTFS is FUSE. SYS_RAWIO: SG_IO for the changer, sg_raw and LTFS.
# The flag variables are unbraced so systemd word-splits them.
ExecStart=/usr/bin/docker run --rm --name tape-archiver-data-worker \
    --pull=never \
    --env-file /etc/tape-archiver/data-worker.env \
    $DEVICE_FLAGS \
    $MHVTL_DEVICE_FLAGS \
    --cap-add SYS_ADMIN \
    --cap-add SYS_RAWIO \
    --mount type=bind,source=/mnt/bulk-pool-01,target=/mnt/bulk-pool-01,bind-propagation=rslave \
    ${TAPE_ARCHIVER_IMAGE}

# Let an in-flight activity drain. TimeoutStopSec must exceed the docker stop
# timeout so systemd does not SIGKILL first.
ExecStop=/bin/sh -c '/usr/bin/docker stop --time="$${TAPE_ARCHIVER_STOP_TIMEOUT:-300}" tape-archiver-data-worker'
TimeoutStopSec=360

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
